# Server Port and Mode
PORT=5055
NODE_ENV=development

# Database Connection
MONGODB_URI=mongodb+srv://25071a0525_db_user:TRAILEXPLORER_2026@local-heritage-trail-ex.1hoftlr.mongodb.net/local_heritage_trail_explorer_dev?retryWrites=true&w=majority&appName=local-heritage-trail-explorer

# Optional DNS configuration for networks that block SRV queries (defaults to Google & Cloudflare DNS)
# DNS_SERVERS=8.8.8.8,1.1.1.1
# DNS_OVERRIDE=true

# Session Secret (Crypto Random Key)
SESSION_SECRET=your_super_secret_session_key_here

# Frontend Client Origin (For CORS and Cookies)
CLIENT_ORIGIN=http://localhost:5185

# Ollama Embedding & LLM Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_MS=60000

# RAG & Development Retrieval Configuration
# Set to true to test the browser UI with approved historical passages before Member 7 finishes vector search:
DEV_FALLBACK_RETRIEVER=true

# Document Chunking Configuration
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# Email Delivery Configuration (Optional - Defaults to console logger in dev mode)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_SECURE=false
EMAIL_FROM=noreply@tirumalaheritage.org