# Server Port and Mode
PORT=5000
NODE_ENV=development

# Database Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/heritage_trail?retryWrites=true&w=majority

# Optional DNS configuration for networks that block SRV queries (defaults to Google & Cloudflare DNS)
# DNS_SERVERS=8.8.8.8,1.1.1.1
# DNS_OVERRIDE=true

# Session Secret (Crypto Random Key)
SESSION_SECRET=your_super_secret_session_key_here

# Frontend Client Origin (For CORS and Cookies)
CLIENT_ORIGIN=http://localhost:5173

# Ollama Embedding Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768

# Document Chunking Configuration
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# Email Delivery Configuration (Optional - Defaults to console logger in dev mode)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_SECURE=false
EMAIL_FROM=noreply@tirumalaheritage.org
