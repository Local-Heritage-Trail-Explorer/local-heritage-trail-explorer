# Server Port and Mode
PORT=5000
NODE_ENV=development

# Database Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/heritage_trail_db?retryWrites=true&w=majority

# Session Secret (Crypto Random Key)
SESSION_SECRET=your_super_secret_session_key_here

# Frontend Client Origin (For CORS and Cookies)
CLIENT_ORIGIN=http://localhost:5173

# Email Delivery Configuration (Optional - Defaults to console logger in dev mode)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_SECURE=false
EMAIL_FROM=noreply@tirumalaheritage.org
